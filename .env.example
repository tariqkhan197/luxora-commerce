# -----------------------------------------------------------------------------
# Luxora — environment variables
# Copy to .env.local for development. Never commit real values.
# -----------------------------------------------------------------------------

# --- Supabase (public; shipped to the browser) -------------------------------
# Project URL from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…). The legacy "anon" JWT also works here.
# Safe for the browser: every request is subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Canonical site URL used in auth emails and redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (server only; NEVER expose to the client) ----------------------
# Secret key (sb_secret_…) or legacy service_role JWT. Bypasses RLS.
# Only read by src/lib/supabase/admin.ts (guarded by `server-only`).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Database (local tooling only) -------------------------------------------
# Used by `npm run db:reset:local` / `npm run db:seed:dev` against plain Postgres.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/luxora_dev
# Used by `npm run test:db` (database is dropped and recreated on every run!).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/luxora_test

# --- Payments (Phase 4b: Stripe TEST MODE only) -------------------------------
# Leave PAYMENT_PROVIDER unset to keep online payment off (orders stay
# "awaiting payment" and expire, as in Phase 3). See docs/PAYMENTS.md.
# Live keys (sk_live_/rk_live_) are refused: live payments are blocked until
# Stripe, business and legal approval are confirmed.
# PAYMENT_PROVIDER=stripe
# Test-mode secret key (sk_test_…) or restricted key (rk_test_…). Server only.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Signing secret of the webhook endpoint (whsec_…). Locally: printed by
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
